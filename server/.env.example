# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/codetrack
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Email / OTP (optional depending on provider)
# BREVO_API_KEY=
# RESEND_API_KEY=

# Codeforces (uses public API — no key required)
# CF timeouts are configured in codeforces.services.js

# LeetCode Phase 2 — public GraphQL only (no API key, no session cookies)
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql/
LEETCODE_TIMEOUT_MS=12000
# Max recent public submissions to import per sync (LeetCode caps ~20)
LEETCODE_RECENT_LIMIT=20

# Do NOT set LEETCODE_API_KEY — LeetCode does not provide a general public API key.
# Do NOT store LEETCODE_SESSION cookies in this Phase 2 integration.
